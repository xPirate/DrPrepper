[Unit]
Description=Dr.Prepper field EHR web console (also runs syslog forwarding and scheduled backups)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
User=drprepper
Group=drprepper
EnvironmentFile=/etc/default/drprepper
# TLS certificate is managed from Admin > Trust center (/etc/drprepper/tls.crt, tls.key)
ExecStart=/opt/drprepper/venv/bin/drprepper-manage serve --host 0.0.0.0 --port 8443
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/drprepper /etc/drprepper /mnt/drp-backup
UMask=0077

[Install]
WantedBy=multi-user.target
